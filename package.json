{
  "name": "agent-cli",
  "version": "0.1.0",
  "description": "Custom AI Coding Agent CLI — provider-agnostic, token-efficient, verification-first. Runs on laptop and Termux.",
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-cli": "./bin/agent-cli.js"
  },
  "files": [
    "bin/",
    "dist/",
    "templates/",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node ./dist/index.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "watch": "python3 scripts/watch-and-check.py",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ink": "^4.4.1",
    "react": "^18.3.1",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.21.4",
    "tree-sitter-typescript": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-agent",
    "ink",
    "termux"
  ]
}
